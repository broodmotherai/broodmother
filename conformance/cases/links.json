[
  {
    "name": "extract: nothing",
    "source": "extract\u0001just prose\n"
  },
  {
    "name": "extract: a wikilink",
    "source": "extract\u0001see [[notes/sync]] for more\n"
  },
  {
    "name": "extract: a wikilink with an alias",
    "source": "extract\u0001see [[notes/sync|the sync note]]\n"
  },
  {
    "name": "extract: a wikilink to a heading",
    "source": "extract\u0001see [[notes/sync#today]]\n"
  },
  {
    "name": "extract: a wikilink to a block",
    "source": "extract\u0001see [[notes/sync^abc123]]\n"
  },
  {
    "name": "extract: a wikilink with padding inside",
    "source": "extract\u0001see [[  notes/sync  ]]\n"
  },
  {
    "name": "extract: an empty wikilink",
    "source": "extract\u0001see [[]] and [[   ]]\n"
  },
  {
    "name": "extract: two on one line",
    "source": "extract\u0001[[a]] and [[b]]\n"
  },
  {
    "name": "extract: a markdown link",
    "source": "extract\u0001see [the note](notes/sync.md)\n"
  },
  {
    "name": "extract: a markdown link with a title",
    "source": "extract\u0001[the note](notes/sync.md \"hover\")\n"
  },
  {
    "name": "extract: a markdown link to a heading",
    "source": "extract\u0001[x](notes/sync.md#today)\n"
  },
  {
    "name": "extract: a markdown link that is only a heading",
    "source": "extract\u0001[x](#today)\n"
  },
  {
    "name": "extract: a markdown link to the web",
    "source": "extract\u0001[x](https://example.invalid/a)\n"
  },
  {
    "name": "extract: a markdown link with a scheme of its own",
    "source": "extract\u0001[x](mailto:a@b)\n"
  },
  {
    "name": "extract: a markdown link with an escape in it",
    "source": "extract\u0001[x](notes/a%20file.md)\n"
  },
  {
    "name": "extract: a markdown link with a broken escape",
    "source": "extract\u0001[x](notes/100%25.md)\n"
  },
  {
    "name": "extract: both kinds together",
    "source": "extract\u0001[[a]] then [b](c.md)\n"
  },
  {
    "name": "extract: the context is the trimmed line",
    "source": "extract\u0001   - see [[a]]   \n"
  },
  {
    "name": "extract: across lines",
    "source": "extract\u0001[[a]]\n\n[[b]]\n"
  },
  {
    "name": "extract: a link inside a code fence is still a link here",
    "source": "extract\u0001```\n[[a]]\n```\n"
  },
  {
    "name": "extract: unicode targets",
    "source": "extract\u0001[[notes/日本語]] and [x](notes/préséntation.md)\n"
  },
  {
    "name": "resolve: an exact path",
    "source": "resolve\u0001[\"notes/sync.md\", \"sync.md\", \"docs/plans/sync.md\", \"a.md\", \"deep/deeper/a.md\"]\u0001notes/sync.md"
  },
  {
    "name": "resolve: a path without the extension",
    "source": "resolve\u0001[\"notes/sync.md\", \"sync.md\", \"docs/plans/sync.md\", \"a.md\", \"deep/deeper/a.md\"]\u0001notes/sync"
  },
  {
    "name": "resolve: a bare filename",
    "source": "resolve\u0001[\"notes/sync.md\", \"sync.md\", \"docs/plans/sync.md\", \"a.md\", \"deep/deeper/a.md\"]\u0001sync.md"
  },
  {
    "name": "resolve: a bare filename with no extension",
    "source": "resolve\u0001[\"notes/sync.md\", \"sync.md\", \"docs/plans/sync.md\", \"a.md\", \"deep/deeper/a.md\"]\u0001sync"
  },
  {
    "name": "resolve: the shortest wins where more than one answers",
    "source": "resolve\u0001[\"notes/sync.md\", \"sync.md\", \"docs/plans/sync.md\", \"a.md\", \"deep/deeper/a.md\"]\u0001a"
  },
  {
    "name": "resolve: nothing answers",
    "source": "resolve\u0001[\"notes/sync.md\", \"sync.md\", \"docs/plans/sync.md\", \"a.md\", \"deep/deeper/a.md\"]\u0001nowhere"
  },
  {
    "name": "resolve: an empty target",
    "source": "resolve\u0001[\"notes/sync.md\", \"sync.md\", \"docs/plans/sync.md\", \"a.md\", \"deep/deeper/a.md\"]\u0001"
  },
  {
    "name": "resolve: no documents at all",
    "source": "resolve\u0001[]\u0001a"
  },
  {
    "name": "resolve: a tie broken by the browser's order",
    "source": "resolve\u0001[\"Ba.md\", \"aa.md\", \"ab.md\"]\u0001x"
  },
  {
    "name": "resolve: case matters",
    "source": "resolve\u0001[\"notes/sync.md\", \"sync.md\", \"docs/plans/sync.md\", \"a.md\", \"deep/deeper/a.md\"]\u0001SYNC"
  },
  {
    "name": "rewrite: a bare wikilink stays bare",
    "source": "rewrite\u0001[\"notes/sync.md\", \"sync.md\", \"docs/plans/sync.md\", \"a.md\", \"deep/deeper/a.md\"]\u0001notes/sync.md\u0001notes/archive/sync.md\u0001see [[sync]]\n"
  },
  {
    "name": "rewrite: a pathed wikilink keeps its path",
    "source": "rewrite\u0001[\"notes/sync.md\", \"sync.md\", \"docs/plans/sync.md\", \"a.md\", \"deep/deeper/a.md\"]\u0001notes/sync.md\u0001notes/archive/sync.md\u0001see [[notes/sync]]\n"
  },
  {
    "name": "rewrite: an alias survives",
    "source": "rewrite\u0001[\"notes/sync.md\", \"sync.md\", \"docs/plans/sync.md\", \"a.md\", \"deep/deeper/a.md\"]\u0001notes/sync.md\u0001notes/archive/sync.md\u0001see [[notes/sync|the note]]\n"
  },
  {
    "name": "rewrite: a markdown link is re-encoded",
    "source": "rewrite\u0001[\"notes/sync.md\", \"sync.md\", \"docs/plans/sync.md\", \"a.md\", \"deep/deeper/a.md\"]\u0001notes/sync.md\u0001notes/a file.md\u0001see [x](notes/sync.md)\n"
  },
  {
    "name": "rewrite: a link that points elsewhere is left alone",
    "source": "rewrite\u0001[\"notes/sync.md\", \"sync.md\", \"docs/plans/sync.md\", \"a.md\", \"deep/deeper/a.md\"]\u0001notes/sync.md\u0001b.md\u0001see [[a]] and [x](https://e.invalid)\n"
  },
  {
    "name": "rewrite: the same link twice",
    "source": "rewrite\u0001[\"notes/sync.md\", \"sync.md\", \"docs/plans/sync.md\", \"a.md\", \"deep/deeper/a.md\"]\u0001notes/sync.md\u0001moved.md\u0001[[notes/sync]] and again [[notes/sync]]\n"
  },
  {
    "name": "rewrite: nothing to rewrite",
    "source": "rewrite\u0001[\"notes/sync.md\", \"sync.md\", \"docs/plans/sync.md\", \"a.md\", \"deep/deeper/a.md\"]\u0001notes/sync.md\u0001moved.md\u0001just prose\n"
  },
  {
    "name": "rewrite: a unicode destination",
    "source": "rewrite\u0001[\"notes/sync.md\", \"sync.md\", \"docs/plans/sync.md\", \"a.md\", \"deep/deeper/a.md\"]\u0001notes/sync.md\u0001notes/日本語.md\u0001see [x](notes/sync.md)\n"
  }
]
