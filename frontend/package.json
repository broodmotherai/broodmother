{
  "name": "@broodmother/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.9.0" },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p ${PORT:-4243}",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p ${PORT:-4243}",
    "wasm": "asc src/wasm/Kernel.ts -o public/task-kernel.wasm -O3 --runtime stub --initialMemory 8 --use abort=",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint",
    "test": "vitest run",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check ."
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@shikijs/monaco": "^4.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "fuzzysort": "^3.1.0",
    "katex": "^0.18.1",
    "markdown-it": "^14.3.0",
    "monaco-editor": "^0.56.0",
    "next": "^16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "assemblyscript": "^0.28.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "^29.0.0",
    "postcss": "8.5.26",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "^4.1.10"
  },
  "overrides": { "react": "19.2.8", "react-dom": "19.2.8" }
