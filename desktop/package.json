{
  "name": "@broodmother/desktop",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "tsc -p .",
    "dev": "npm run compile && electron .",
    "package": "electron-packager . broodmother --platform=darwin --overwrite --out=out --app-bundle-id=ai.broodmother.desktop --app-version=$npm_package_version --icon=build/icon.icns --extra-resource=build/daemon --extra-resource=build/site --ignore=\"^/src$\" --ignore=\"^/build$\" --ignore=\"^/node_modules$\" --ignore=\"^/out$\" --ignore=\"^/README\\.md$\" --ignore=\"^/Makefile$\" --ignore=\"^/tsconfig\\.json$\"",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.1.2",
    "electron": "^43.4.1",
    "typescript": "^5.9.3"
  }
}
